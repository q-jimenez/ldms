# Benchmark with MiniFE
MESSAGE Beginning Benchmark:
MINIDIR=$STOREDIR/miniFE
mkdir $MINIDIR
DAEMONS 2
LDMSD -c 1
#Set XUSER={username}
XUSER=foo
for n in 20; do #12 16 20; do
  LDMSD -c 2
  #Where n is the number of mpi tasks
  sudo -u $XUSER mpirun -np $n --bind-to core --map-by core $MINI_FE_PATH/miniFE.x -nx 256 -ny 256 -nz 256 > $MINIDIR/${testname}_benchmark_${n}
  SLEEP 10
  LDMS_LS 1 -v
  SLEEP 1
  LDMS_LS 2 -v
  SLEEP 1
  pkill mpirun
done
KILL_LDMSD 1 2
file_created $STOREDIR/node/$testname
chown -R $XUSER /home/$XUSER/ldms