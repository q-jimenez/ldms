load name=store_csv
config name=store_csv path=${STOREDIR} altheader=0

prdcr_add name=localhost1 host=${HOST} type=active xprt=${XPRT} port=${port1} reconnect=2000000
prdcr_start name=localhost1

strgp_add name=store_${plugname} plugin=store_csv schema=${plugname} container=node decomposition=${PERFDECOMP}
strgp_prdcr_add name=store_${plugname} regex=.*
strgp_start name=store_${plugname}

updtr_add name=allhosts interval=1000000 offset=200000
updtr_prdcr_add name=allhosts regex=.*
updtr_start name=allhosts
